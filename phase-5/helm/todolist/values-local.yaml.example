# Local development values for TodoList Pro Kubernetes deployment
# Copy this file to values-local.yaml and fill in your secrets

# IMPORTANT: Never commit values-local.yaml to version control!

# Database connection (Neon PostgreSQL)
secrets:
  # PostgreSQL connection string with asyncpg driver
  # Format: postgresql+asyncpg://user:password@host/database?ssl=require
  databaseUrl: "postgresql+asyncpg://your-user:your-password@your-host/your-db?ssl=require"

  # Better Auth secret (32+ character secret key)
  # Generate with: openssl rand -hex 32
  betterAuthSecret: "your-32-character-secret-key-here"

  # Gemini API key (optional, for AI features)
  geminiApiKey: ""

# Optional overrides for local development
frontend:
  replicas: 1
  resources:
    requests:
      memory: "128Mi"
      cpu: "100m"
    limits:
      memory: "256Mi"
      cpu: "500m"

backend:
  replicas: 1
  resources:
    requests:
      memory: "256Mi"
      cpu: "100m"
    limits:
      memory: "512Mi"
      cpu: "500m"
